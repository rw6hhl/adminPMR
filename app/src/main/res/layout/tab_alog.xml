<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <Button
            android:id="@+id/btnAlogClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear"
            android:backgroundTint="@color/c_red"
            android:textColor="@color/c_white" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@color/c_log_bg">

            <TextView
                android:id="@+id/alogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/c_log_text"
                android:textSize="12sp" />

        </ScrollView>

    </LinearLayout>

    <!-- Плавающее окно активного абонента -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp"
        android:background="@color/c_white"
        android:elevation="8dp">

        <TextView
            android:id="@+id/alogActiveNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/c_red"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alogActiveName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="нет активного"
            android:textColor="@color/c_text"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>